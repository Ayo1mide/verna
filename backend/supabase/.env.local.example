SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Verna-issued app JWTs. Use a long random value, 32+ chars minimum.
VERNA_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Custom Google OAuth, not Supabase hosted Google auth.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:54321/functions/v1/google-oauth-callback
GOOGLE_OAUTH_SCOPES=openid email profile
GOOGLE_OAUTH_PROMPT=select_account
GOOGLE_OAUTH_ACCESS_TYPE=offline

# Keep false for a clean Google-only launch.
# Set true only if you intentionally want verified Google emails to claim old auth.users rows.
GOOGLE_LINK_EXISTING_EMAIL_USERS=false

# Frontend callback allowlist.
VERNA_FRONTEND_URL=http://localhost:5173
VERNA_ALLOWED_REDIRECT_ORIGINS=http://localhost:5173

# AI and workers.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
PROCESS_AI_JOBS_SECRET=replace-with-a-long-random-secret
MODERATOR_API_SECRET=replace-with-a-long-random-secret

# Billing.
STRIPE_SECRET_KEY=sk_test_or_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_...
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your-flutterwave-verif-hash
FLW_PREMIUM_PLAN_ID=
FLW_PREMIUM_AMOUNT=4.99
FLW_PREMIUM_CURRENCY=USD
FLW_PREMIUM_PLAN_NAME=VERNA Premium Monthly
